{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSqlLocalDb;Database=EmployeeDatabase;Trusted_Connection=True;MultipleActiveResultSets=true"
  },

  "NCacheSettings": {
    "CacheName": "demoCache",
    "EnableLogs": "True",
    "RequestTimeout": "90",
    "EnableDetailLogs": false,
    "ExceptionsEnabled": true,
    "OperationRetry": 0,
    "OperationRetryInterval": 0
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
